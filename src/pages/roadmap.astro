---
import BaseLayout from '../layouts/BaseLayout.astro';
import { ROADMAP_STAGES } from '../data/roadmap';
import { SITE_PROFILE } from '../data/profile';
import { withBase } from '../utils/paths';

const statusLabels = {
  completed: { text: '已完成', cls: 'bg-emerald-500/15 text-emerald-400 border-emerald-400/30' },
  'in-progress': { text: '正在攻坚', cls: 'bg-violet-500/20 text-violet-300 border-violet-400/40' },
  upcoming: { text: '下一阶段规划', cls: 'bg-amber-500/15 text-amber-300 border-amber-400/30' },
};
---

<BaseLayout
  title={`学习路线 · ${SITE_PROFILE.brand}`}
  description="从大一 C 语言启蒙、加入 3G 移动应用开发实验室，到 Objective-C / UIKit / Python 与 Swift 的完整学习路线图"
  currentPath="/roadmap"
>
  <section class="max-w-5xl mx-auto px-4 sm:px-6 pt-28 pb-10">
    <!-- Page Hero -->
    <div class="space-y-4 mb-12 reveal">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full liquid-glass text-xs font-mono text-[var(--accent)]">
        <span>LEARNING ROADMAP</span>
        <span class="opacity-40">·</span>
        <span>2025.09 — 2027</span>
      </div>
      <h1 class="font-serif text-3xl sm:text-5xl font-bold text-[var(--text-primary)] leading-tight">
        我的 iOS 与编程成长路线图
      </h1>
      <p class="text-sm sm:text-base text-[var(--text-secondary)] max-w-2xl leading-relaxed">
        大一上从第一行 C 语言起步，通过一面二面加入学校 3G 移动应用开发实验室；大一下潜心 Objective-C 与 UIKit，大二向完整架构、Python 工具链与 Swift 演进。每个阶段都留下了真实的代码仓库与复盘周报。
      </p>

      <!-- Progress Summary Strip -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-4">
        <div class="bento-card p-4">
          <div class="text-[11px] font-mono text-[var(--text-muted)]">编程起点</div>
          <div class="font-serif text-xl font-bold text-sky-400 mt-1">2025.09</div>
          <div class="text-xs text-[var(--text-secondary)] mt-0.5">C 语言 &amp; 数据结构</div>
        </div>
        <div class="bento-card p-4">
          <div class="text-[11px] font-mono text-[var(--text-muted)]">主攻方向</div>
          <div class="font-serif text-xl font-bold text-violet-400 mt-1">iOS 原生</div>
          <div class="text-xs text-[var(--text-secondary)] mt-0.5">OC · UIKit · Swift</div>
        </div>
        <div class="bento-card p-4">
          <div class="text-[11px] font-mono text-[var(--text-muted)]">拓展技能</div>
          <div class="font-serif text-xl font-bold text-emerald-400 mt-1">Python</div>
          <div class="text-xs text-[var(--text-secondary)] mt-0.5">爬虫 · Socket · 可视化</div>
        </div>
        <div class="bento-card p-4">
          <div class="text-[11px] font-mono text-[var(--text-muted)]">当前状态</div>
          <div class="font-serif text-xl font-bold text-pink-400 mt-1">Phase 04</div>
          <div class="text-xs text-[var(--text-secondary)] mt-0.5">音乐播放器架构 + Swift</div>
        </div>
      </div>
    </div>

    <!-- Vertical Luminous Timeline -->
    <div class="relative pl-6 sm:pl-10 space-y-8 before:content-[''] before:absolute before:left-[11px] sm:before:left-[15px] before:top-3 before:bottom-3 before:w-[2px] before:bg-gradient-to-b before:from-sky-400 before:via-violet-500 before:to-amber-400/50">
      {ROADMAP_STAGES.map((stage) => {
        const badge = statusLabels[stage.status];
        return (
          <article id={stage.id} class="relative scroll-mt-24 reveal">
            <!-- Timeline Node Dot -->
            <span
              class="absolute -left-[25px] sm:-left-[37px] top-6 w-5 h-5 rounded-full border-4 border-[var(--bg-canvas)] shadow-lg"
              style={`background-color: ${stage.accentColor}; box-shadow: 0 0 16px ${stage.accentColor}88;`}
            />

            <div class="bento-card p-6 sm:p-8 specular-edge">
              <!-- Top Meta Row -->
              <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
                <div class="flex flex-wrap items-center gap-2.5">
                  <span
                    class="text-xs font-mono font-semibold px-2.5 py-0.5 rounded-md"
                    style={`background-color: ${stage.accentColor}22; color: ${stage.accentColor};`}
                  >
                    {stage.phase}
                  </span>
                  <span class="text-xs font-mono text-[var(--text-muted)]">{stage.period}</span>
                  <span class="text-xs px-2.5 py-0.5 rounded-full bg-[var(--bg-pill)] text-[var(--text-secondary)]">
                    {stage.semester}
                  </span>
                </div>
                <span class={`text-[11px] font-mono px-2.5 py-1 rounded-full border ${badge.cls}`}>
                  {badge.text}
                </span>
              </div>

              <!-- Title & Summary -->
              <h2 class="font-serif text-xl sm:text-2xl font-bold text-[var(--text-primary)]">
                {stage.title}
              </h2>
              <p class="text-xs font-mono text-[var(--text-muted)] mt-1">{stage.subtitle}</p>
              <p class="text-sm text-[var(--text-secondary)] leading-relaxed mt-3">
                {stage.summary}
              </p>

              <!-- Skills Matrix -->
              <div class="mt-5">
                <div class="text-[11px] font-mono uppercase tracking-wider text-[var(--text-muted)] mb-2">
                  掌握与实践要点
                </div>
                <div class="flex flex-wrap gap-2">
                  {stage.skills.map((skill) => (
                    <span class="px-3 py-1 rounded-full text-xs bg-[var(--bg-pill)] border border-[var(--border-subtle)] text-[var(--text-secondary)]">
                      {skill}
                    </span>
                  ))}
                </div>
              </div>

              <!-- Real Deliverables -->
              <div class="mt-6 grid grid-cols-1 md:grid-cols-3 gap-3">
                {stage.deliverables.map((d) => (
                  <div class="p-3.5 rounded-2xl bg-[var(--bg-pill)] border border-[var(--border-subtle)] flex flex-col justify-between gap-2">
                    <div>
                      <div class="text-xs font-semibold text-[var(--text-primary)]">{d.label}</div>
                      <p class="text-[11.5px] text-[var(--text-muted)] mt-1 leading-relaxed">{d.detail}</p>
                    </div>
                    {d.url && (
                      <a
                        href={d.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-[11px] font-mono text-[var(--accent)] hover:underline inline-flex items-center gap-1"
                      >
                        查看沉淀 ↗
                      </a>
                    )}
                  </div>
                ))}
              </div>

              <!-- Reflection Blockquote -->
              <div
                class="mt-5 pl-4 py-2 border-l-2 text-xs sm:text-sm font-serif italic text-[var(--text-secondary)]"
                style={`border-color: ${stage.accentColor};`}
              >
                “{stage.reflections}”
              </div>
            </div>
          </article>
        );
      })}
    </div>

    <!-- Bottom CTA -->
    <div class="mt-12 bento-card p-6 sm:p-8 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 reveal">
      <div>
        <h3 class="font-serif text-lg font-bold text-[var(--text-primary)]">想看每个阶段对应的真实代码与文章？</h3>
        <p class="text-xs sm:text-sm text-[var(--text-secondary)] mt-1">
          前往项目展厅体验 MyMusic 实机界面，或在精选笔记页检索我的 C / OC / Python 博客。
        </p>
      </div>
      <div class="flex items-center gap-2.5 shrink-0">
        <a
          href={withBase('/projects')}
          class="px-4 py-2 rounded-full text-xs font-medium bg-[var(--accent)] text-white hover:brightness-110 transition-all"
        >
          项目展厅 →
        </a>
        <a
          href={withBase('/notes')}
          class="px-4 py-2 rounded-full text-xs font-medium liquid-glass text-[var(--text-primary)] hover:border-[var(--accent)] transition-all"
        >
          精选笔记
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
