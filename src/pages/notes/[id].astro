---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE_PROFILE } from '../../data/profile';
import { ARTICLE_CATEGORY_META, ARTICLES } from '../../data/articles';
import { withBase } from '../../utils/paths';

export async function getStaticPaths() {
  const entries = await getCollection('notes');
  return entries.map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const { title, category, categoryLabel, subTag, date, readTime, summary, csdnUrl } = entry.data;
const meta = ARTICLE_CATEGORY_META[category];

// Order prev/next following ARTICLES list order
const orderIndex = ARTICLES.findIndex((a) => a.id === entry.id);
const prevArticle =
  orderIndex >= 0
    ? ARTICLES[(orderIndex - 1 + ARTICLES.length) % ARTICLES.length]
    : ARTICLES[0];
const nextArticle =
  orderIndex >= 0
    ? ARTICLES[(orderIndex + 1) % ARTICLES.length]
    : ARTICLES[1];

const tocHeadings = headings.filter((h) => h.depth >= 1 && h.depth <= 3);
const wordCount = (entry.body || '').replace(/\s+/g, '').length;
---

<BaseLayout
  title={`${title} · ${SITE_PROFILE.brand}`}
  description={summary}
  currentPath="/notes"
>
  <!-- Top Reading Progress Bar -->
  <div class="fixed top-0 inset-x-0 z-[60] h-[3px] bg-transparent pointer-events-none">
    <div
      id="reading-progress-bar"
      class="h-full w-0 bg-gradient-to-r from-violet-400 via-sky-400 to-emerald-400 transition-[width] duration-100"
    />
  </div>

  <article class="max-w-6xl mx-auto px-4 sm:px-6 pt-28 pb-16">
    <!-- Top Back & Breadcrumb Bar -->
    <div class="flex flex-wrap items-center justify-between gap-3 mb-6">
      <a
        href={withBase('/notes')}
        class="inline-flex items-center gap-1.5 px-4 py-2 rounded-full text-xs font-medium liquid-glass text-[var(--text-primary)] hover:border-[var(--accent)] hover:text-[var(--accent)] transition-all"
      >
        ← 返回精选笔记
      </a>

      <div class="flex items-center gap-2 text-xs font-mono text-[var(--text-muted)]">
        <a href={withBase('/')} class="hover:text-[var(--accent)] transition-colors">首页</a>
        <span>/</span>
        <a href={withBase('/notes')} class="hover:text-[var(--accent)] transition-colors">笔记</a>
        <span>/</span>
        <span style={`color: ${meta.color};`}>{categoryLabel}</span>
      </div>
    </div>

    <!-- Article Header Card -->
    <header class="bento-card p-6 sm:p-10 mb-8 specular-edge article-card-solid">
      <div class="flex flex-wrap items-center gap-2.5 text-xs font-mono mb-4">
        <span
          class="px-3 py-1 rounded-full font-medium"
          style={`background-color: ${meta.color}24; color: ${meta.color}; border: 1px solid ${meta.color}48;`}
        >
          # {categoryLabel}
        </span>
        <span class="px-2.5 py-1 rounded-full bg-[var(--bg-pill)] border border-[var(--border-subtle)] text-[var(--text-secondary)]">
          {subTag}
        </span>
        <span class="text-[var(--text-muted)]">{date}</span>
        <span class="opacity-40">·</span>
        <span class="text-[var(--text-muted)]">约 {readTime}</span>
        <span class="opacity-40">·</span>
        <span class="text-[var(--text-muted)]">{wordCount.toLocaleString()} 字</span>
      </div>

      <h1 class="font-serif text-2xl sm:text-4xl font-bold text-[var(--text-primary)] leading-tight">
        {title}
      </h1>

      <p class="mt-4 text-sm sm:text-base text-[var(--text-secondary)] leading-relaxed max-w-3xl">
        {summary}
      </p>

      {csdnUrl && (
        <div class="mt-5 pt-4 border-t border-[var(--border-subtle)] flex flex-wrap items-center justify-between gap-3 text-xs">
          <span class="text-[var(--text-muted)] font-mono">
            作者：{SITE_PROFILE.displayName} · 站内原生阅读版
          </span>
          <a
            href={csdnUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="text-[var(--text-muted)] hover:text-[var(--accent)] font-mono transition-colors"
          >
            外部备份链接 ↗
          </a>
        </div>
      )}
    </header>

    <!-- Main Body + Right Sticky TOC -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 items-start">
      <!-- Markdown Prose Content -->
      <div class="lg:col-span-9 min-w-0">
        <div class="bento-card p-6 sm:p-10 article-card-solid specular-edge">
          <div class="article-prose">
            <Content />
          </div>
        </div>

        <!-- Prev / Next In-Site Navigation -->
        <nav class="mt-8 grid grid-cols-1 sm:grid-cols-2 gap-4" aria-label="上下篇文章切换">
          <a
            href={withBase(`/notes/${prevArticle.id}`)}
            class="group bento-card bento-card-lift p-5 flex flex-col justify-between gap-2 specular-edge"
          >
            <span class="text-[11px] font-mono text-[var(--text-muted)]">← 上一篇笔记</span>
            <span class="font-serif text-base font-bold text-[var(--text-primary)] group-hover:text-[var(--accent)] transition-colors line-clamp-2">
              {prevArticle.title}
            </span>
            <span class="text-[11px] font-mono text-[var(--text-muted)]">
              {prevArticle.categoryLabel} · {prevArticle.date}
            </span>
          </a>

          <a
            href={withBase(`/notes/${nextArticle.id}`)}
            class="group bento-card bento-card-lift p-5 flex flex-col justify-between gap-2 sm:text-right specular-edge"
          >
            <span class="text-[11px] font-mono text-[var(--text-muted)]">下一篇笔记 →</span>
            <span class="font-serif text-base font-bold text-[var(--text-primary)] group-hover:text-[var(--accent)] transition-colors line-clamp-2">
              {nextArticle.title}
            </span>
            <span class="text-[11px] font-mono text-[var(--text-muted)]">
              {nextArticle.categoryLabel} · {nextArticle.date}
            </span>
          </a>
        </nav>
      </div>

      <!-- Sticky Table of Contents Sidebar -->
      <aside class="lg:col-span-3 lg:sticky lg:top-24 space-y-4">
        {tocHeadings.length > 0 && (
          <div class="bento-card p-5 article-card-solid">
            <div class="flex items-center justify-between mb-3 pb-2 border-b border-[var(--border-subtle)]">
              <span class="text-xs font-mono font-semibold uppercase tracking-wider text-[var(--text-primary)]">
                文章目录
              </span>
              <span class="text-[10px] font-mono text-[var(--text-muted)]">
                {tocHeadings.length} 节
              </span>
            </div>
            <ul class="space-y-1.5 max-h-[60vh] overflow-y-auto pr-1 text-xs">
              {tocHeadings.map((h) => (
                <li style={`padding-left: ${(h.depth - 1) * 10}px;`}>
                  <a
                    href={`#${h.slug}`}
                    data-toc-link={h.slug}
                    class="block py-1 text-[var(--text-secondary)] hover:text-[var(--accent)] transition-colors leading-snug truncate"
                  >
                    {h.text}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}

        <div class="bento-card p-5 space-y-3">
          <div class="text-xs font-mono text-[var(--accent)]">✦ 学习路线关联</div>
          <p class="text-xs text-[var(--text-secondary)] leading-relaxed">
            本篇沉淀自我的真实学习仓库 <code class="font-mono text-[11px]">note/</code>，点击可查看完整阶段路线或同专栏其他笔记。
          </p>
          <div class="flex flex-wrap gap-2">
            <a
              href={withBase('/notes')}
              class="px-3 py-1.5 rounded-full text-[11px] font-medium bg-[var(--accent-soft)] text-[var(--accent)] hover:brightness-110 transition-all"
            >
              全部笔记
            </a>
            <a
              href={withBase('/roadmap')}
              class="px-3 py-1.5 rounded-full text-[11px] font-medium bg-[var(--bg-pill)] border border-[var(--border-subtle)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-all"
            >
              学习路线
            </a>
          </div>
        </div>
      </aside>
    </div>
  </article>

  <script is:inline>
    (function () {
      // Reading progress bar
      const bar = document.getElementById('reading-progress-bar');
      function updateProgress() {
        if (!bar) return;
        const scrollTop = window.scrollY;
        const docHeight = document.documentElement.scrollHeight - window.innerHeight;
        const pct = docHeight > 0 ? Math.min(100, Math.max(0, (scrollTop / docHeight) * 100)) : 0;
        bar.style.width = pct.toFixed(1) + '%';
      }
      window.addEventListener('scroll', updateProgress, { passive: true });
      updateProgress();

      // Add copy button to every pre code block
      document.querySelectorAll('.article-prose pre').forEach((pre) => {
        pre.style.position = 'relative';
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.textContent = '复制';
        btn.className =
          'absolute top-2.5 right-2.5 px-2.5 py-1 rounded-md text-[11px] font-mono bg-white/10 hover:bg-white/20 text-slate-200 border border-white/15 transition-colors cursor-pointer';
        btn.addEventListener('click', async () => {
          const code = pre.querySelector('code')?.textContent || pre.textContent || '';
          try {
            await navigator.clipboard.writeText(code);
            btn.textContent = '已复制 ✓';
            setTimeout(() => (btn.textContent = '复制'), 1600);
          } catch (_) {
            btn.textContent = '复制失败';
          }
        });
        pre.appendChild(btn);
      });

      // Highlight active TOC link on scroll
      const tocLinks = Array.from(document.querySelectorAll('[data-toc-link]'));
      if (tocLinks.length > 0 && 'IntersectionObserver' in window) {
        const headingEls = tocLinks
          .map((a) => document.getElementById(a.getAttribute('data-toc-link') || ''))
          .filter(Boolean);
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                const id = entry.target.id;
                tocLinks.forEach((a) => {
                  const active = a.getAttribute('data-toc-link') === id;
                  a.style.color = active ? 'var(--accent)' : '';
                  a.style.fontWeight = active ? '600' : '';
                });
              }
            });
          },
          { rootMargin: '-90px 0px -70% 0px', threshold: 0 }
        );
        headingEls.forEach((el) => io.observe(el));
      }
    })();
  </script>
</BaseLayout>
