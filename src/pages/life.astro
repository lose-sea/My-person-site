---
import BaseLayout from '../layouts/BaseLayout.astro';
import LifePhotoWall from '../components/LifePhotoWall.tsx';
import { ANIME_WALLPAPERS, LIFE_ESSAYS } from '../data/life';
import { SITE_PROFILE } from '../data/profile';
import { withBase } from '../utils/paths';
---

<BaseLayout
  title={`生活志 · ${SITE_PROFILE.brand}`}
  description="不规则错落生活照片墙、日常随笔与动漫光影壁纸收藏"
  currentPath="/life"
>
  <section class="max-w-6xl mx-auto px-4 sm:px-6 pt-28 pb-10">
    <!-- Hero -->
    <div class="space-y-3 mb-12 reveal">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full liquid-glass text-xs font-mono text-[var(--accent)]">
        <span>LIFE &amp; MOMENTS</span>
        <span class="opacity-40">·</span>
        <span>慢热 · 安静 · 热爱生活</span>
      </div>
      <h1 class="font-serif text-3xl sm:text-5xl font-bold text-[var(--text-primary)] leading-tight drop-shadow">
        代码之外的生活志
      </h1>
      <p class="text-sm sm:text-base text-[var(--text-secondary)] max-w-2xl leading-relaxed">
        “{SITE_PROFILE.tagline}”——不再把日常散落在外部空间，而是直接安放在自己的个人网站里，留住照片、心情与成长瞬间。
      </p>
    </div>

    <!-- Irregular Multi-Size Staggered Life Photo Wall -->
    <LifePhotoWall client:load baseUrl={import.meta.env.BASE_URL} />
  </section>

  <!-- Essays Timeline -->
  <section id="essays" class="max-w-6xl mx-auto px-4 sm:px-6 py-12 scroll-mt-24">
    <div class="mb-8 reveal">
      <span class="text-xs font-mono uppercase tracking-[0.22em] text-[var(--accent)]">
        ESSAYS &amp; FRAGMENTS
      </span>
      <h2 class="font-serif text-2xl sm:text-3xl font-bold text-[var(--text-primary)] mt-1">
        随笔与心情碎片
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
      {LIFE_ESSAYS.map((essay) => (
        <article class="bento-card p-6 space-y-4 specular-edge reveal">
          <div class="flex items-center justify-between text-xs font-mono text-[var(--text-muted)]">
            <span class="px-2.5 py-0.5 rounded-full bg-[var(--accent-soft)] text-[var(--accent)]">
              # {essay.tag}
            </span>
            <span>{essay.date} · {essay.location}</span>
          </div>

          {essay.highlight && (
            <p class="font-serif text-lg font-semibold text-[var(--text-primary)] leading-snug">
              “{essay.highlight}”
            </p>
          )}

          <p class="text-sm text-[var(--text-secondary)] leading-relaxed">
            {essay.content}
          </p>
        </article>
      ))}
    </div>
  </section>

  <!-- Anime Wallpaper Atmosphere Switcher -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 py-10">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-3 mb-6 reveal">
      <div>
        <span class="text-xs font-mono uppercase tracking-[0.22em] text-[var(--accent)]">
          ANIME ATMOSPHERE GALLERY
        </span>
        <h2 class="font-serif text-2xl font-bold text-[var(--text-primary)] mt-1">
          全站二次元光影壁纸 · 点击一键切换背景
        </h2>
      </div>
      <button
        type="button"
        id="reset-lab-sky-btn"
        class="px-3.5 py-1.5 rounded-full text-xs font-mono bg-[var(--bg-pill)] border border-[var(--border-subtle)] text-[var(--text-secondary)] hover:text-[var(--accent)] hover:border-[var(--accent)] transition-all self-start sm:self-auto cursor-pointer"
      >
        切换深空星轨画布
      </button>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 reveal">
      {ANIME_WALLPAPERS.map((wp) => (
        <button
          type="button"
          data-life-wallpaper={wp.id}
          class="group bento-card overflow-hidden text-left p-2 transition-all hover:border-[var(--accent)] hover:-translate-y-1 cursor-pointer"
        >
          <div class="relative aspect-[16/10] rounded-2xl overflow-hidden">
            <img
              src={withBase(wp.src)}
              alt={wp.name}
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
              loading="lazy"
            />
            <span class="absolute top-2.5 right-2.5 px-2 py-0.5 rounded-full text-[10px] font-mono text-white bg-black/50 backdrop-blur-md">
              {wp.tone}
            </span>
          </div>
          <div class="p-3 flex items-center justify-between gap-2">
            <div>
              <div class="text-sm font-semibold text-[var(--text-primary)]">{wp.shortName}</div>
              <div class="text-[11px] text-[var(--text-muted)] truncate">{wp.name}</div>
            </div>
            <span class="text-xs text-[var(--accent)] opacity-75 group-hover:opacity-100">设为背景</span>
          </div>
        </button>
      ))}
    </div>
  </section>

  <script is:inline>
    document.querySelectorAll('[data-life-wallpaper]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const id = btn.getAttribute('data-life-wallpaper') || 'auto';
        document.documentElement.setAttribute('data-atmosphere', 'anime');
        try {
          localStorage.setItem('lose-sea-atmosphere-v2', 'anime');
          localStorage.setItem('lose-sea-wallpaper', id);
        } catch (_) {}
        window.dispatchEvent(new CustomEvent('lose-sea:atmosphere-change'));
        const label = document.getElementById('atmosphere-label');
        const dot = document.getElementById('atmosphere-indicator');
        if (label) label.textContent = '动漫壁纸';
        if (dot) dot.className = 'w-2 h-2 rounded-full bg-emerald-400';
      });
    });

    document.getElementById('reset-lab-sky-btn')?.addEventListener('click', () => {
      document.documentElement.setAttribute('data-atmosphere', 'lab');
      try {
        localStorage.setItem('lose-sea-atmosphere-v2', 'lab');
      } catch (_) {}
      window.dispatchEvent(new CustomEvent('lose-sea:atmosphere-change'));
      const label = document.getElementById('atmosphere-label');
      const dot = document.getElementById('atmosphere-indicator');
      if (label) label.textContent = '星轨';
      if (dot) dot.className = 'w-2 h-2 rounded-full bg-violet-400';
    });
  </script>
</BaseLayout>
