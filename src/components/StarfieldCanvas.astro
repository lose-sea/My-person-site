<canvas
  id="starfield-canvas"
  class="fixed inset-0 z-0 w-full h-full pointer-events-none"
  aria-hidden="true"
></canvas>

<script is:inline>
  (function () {
    const canvas = document.getElementById('starfield-canvas');
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let width = 0;
    let height = 0;
    let stars = [];
    let pointer = { x: -9999, y: -9999 };
    let rafId = null;

    function resize() {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      width = window.innerWidth;
      height = window.innerHeight;
      canvas.width = Math.floor(width * dpr);
      canvas.height = Math.floor(height * dpr);
      canvas.style.width = width + 'px';
      canvas.style.height = height + 'px';
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

      const count = Math.min(95, Math.max(42, Math.floor((width * height) / 17000)));
      stars = Array.from({ length: count }, () => ({
        x: Math.random() * width,
        y: Math.random() * height,
        vx: (Math.random() - 0.5) * 0.16,
        vy: (Math.random() - 0.5) * 0.16,
        r: Math.random() * 1.45 + 0.45,
        phase: Math.random() * Math.PI * 2,
        speed: 0.008 + Math.random() * 0.015,
      }));
    }

    function draw() {
      const theme = document.documentElement.getAttribute('data-theme') || 'dark';
      const isDark = theme === 'dark';

      ctx.clearRect(0, 0, width, height);

      // Subtle base backdrop
      ctx.fillStyle = isDark ? '#090c13' : '#f4f6fb';
      ctx.fillRect(0, 0, width, height);

      for (let i = 0; i < stars.length; i++) {
        const s = stars[i];
        if (!prefersReduced) {
          s.x += s.vx;
          s.y += s.vy;
          s.phase += s.speed;
          if (s.x < 0) s.x = width;
          if (s.x > width) s.x = 0;
          if (s.y < 0) s.y = height;
          if (s.y > height) s.y = 0;
        }

        const twinkle = 0.45 + 0.55 * Math.sin(s.phase);
        ctx.beginPath();
        ctx.arc(s.x, s.y, s.r, 0, Math.PI * 2);
        ctx.fillStyle = isDark
          ? `rgba(216, 228, 255, ${(0.22 + twinkle * 0.55).toFixed(2)})`
          : `rgba(99, 102, 241, ${(0.12 + twinkle * 0.25).toFixed(2)})`;
        ctx.fill();

        // Constellation hairline links
        for (let j = i + 1; j < stars.length; j++) {
          const o = stars[j];
          const dx = s.x - o.x;
          const dy = s.y - o.y;
          const dist = dx * dx + dy * dy;
          if (dist < 14500) {
            const alpha = (1 - dist / 14500) * (isDark ? 0.12 : 0.075);
            ctx.beginPath();
            ctx.moveTo(s.x, s.y);
            ctx.lineTo(o.x, o.y);
            ctx.strokeStyle = isDark
              ? `rgba(148, 163, 248, ${alpha.toFixed(3)})`
              : `rgba(99, 102, 241, ${alpha.toFixed(3)})`;
            ctx.lineWidth = 0.7;
            ctx.stroke();
          }
        }

        // Gentle pointer attraction line
        const pdx = s.x - pointer.x;
        const pdy = s.y - pointer.y;
        const pdist = pdx * pdx + pdy * pdy;
        if (pdist < 22000) {
          const alpha = (1 - pdist / 22000) * (isDark ? 0.26 : 0.16);
          ctx.beginPath();
          ctx.moveTo(s.x, s.y);
          ctx.lineTo(pointer.x, pointer.y);
          ctx.strokeStyle = isDark
            ? `rgba(139, 123, 255, ${alpha.toFixed(3)})`
            : `rgba(108, 92, 231, ${alpha.toFixed(3)})`;
          ctx.lineWidth = 0.85;
          ctx.stroke();
        }
      }

      if (!prefersReduced) {
        rafId = requestAnimationFrame(draw);
      }
    }

    window.addEventListener('resize', resize);
    window.addEventListener('mousemove', (e) => {
      pointer.x = e.clientX;
      pointer.y = e.clientY;
    });
    window.addEventListener('mouseleave', () => {
      pointer.x = -9999;
      pointer.y = -9999;
    });

    resize();
    draw();

    // Redraw immediately when theme flips if reduced motion is active
    window.addEventListener('lose-sea:theme-change', () => {
      if (prefersReduced) draw();
    });
  })();
</script>
